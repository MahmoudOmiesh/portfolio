{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "cd .output && NODE_ENV=production PORT=${PORT:-4317} bun server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "check": "bun run typecheck && bun run lint",
    "resume": "tectonic -X compile resume/resume.tex --outdir public && (pdffonts public/resume.pdf | grep -q XCharter-Bold || (echo 'resume.pdf fell back to Computer Modern: keep the ifPDFTeX block in resume.tex' >&2 && exit 1))",
    "og": "bun scripts/og.tsx",
    "shot": "bun scripts/shot.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@oxlint/plugins": "1.90.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/intent": "^0.5.6",
    "@types/estree": "^1.0.10",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "acorn": "^8.19.0",
    "fast-png": "^8.0.0",
    "lefthook": "^2.2.1",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "mdast-util-to-string": "^4.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.65.1",
    "satori": "^0.63.2",
    "typescript": "^6.0.2",
